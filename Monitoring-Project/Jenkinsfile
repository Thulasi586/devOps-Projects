node {
    stage('SCM') {
        checkout scm
    }

    stage('Install Dependencies') {
        dir('Monitoring-Project/app') {
            sh 'npm install'
        }
    }

    stage('SonarQube Analysis') {
        dir('Monitoring-Project') {
            def scannerHome = tool 'SonarScanner'

            withSonarQubeEnv('sonarqube') {
                sh "${scannerHome}/bin/sonar-scanner"
            }
        }
    }
    stage('Quality Gate') {
        timeout(time: 5, unit: 'MINUTES') {
            waitForQualityGate abortPipeline: true
        }
    }
    stage('OWASP FS Scan') {
        dir('Monitoring-Project') {
            dependencyCheck nvdCredentialsId: 'NVD_API_KEY',
                additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                odcInstallation: 'DP-Check'
            
            dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
        }
    }
    stage('Trivy FS Scan') {
        dir('Monitoring-Project') {
            sh 'trivy fs . > trivyfs.json'
        }
    }
    stage('Docker Build') {
        dir('Monitoring-Project/app') {
            sh 'docker build -t monitoring-app:latest .'
        }
    }
    stage('Trivy Security Scan') {
        sh 'trivy image --severity HIGH,CRITICAL --exit-code 1 monitoring-app:latest'
    }
}
